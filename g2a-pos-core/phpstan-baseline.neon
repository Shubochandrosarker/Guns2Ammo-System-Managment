parameters:
	ignoreErrors:
		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/API/RangeWaiverController.php

		-
			message: "#^Offset 'secret' on non\\-empty\\-array on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 1
			path: includes/API/WebhookController.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/Database/AtfReportRepository.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/Database/BoundBookRepository.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/Database/FflTransferRepository.php

		-
			message: "#^Strict comparison using \\=\\=\\= between mixed~\\(0\\|0\\.0\\|''\\|'0'\\|array\\{\\}\\|false\\|null\\) and '0' will always evaluate to false\\.$#"
			count: 1
			path: includes/Integrations/Membership/UserMetaProvider.php

		-
			message: "#^Constant G2A\\\\POS\\\\Pricing\\\\MapPricingService\\:\\:META_FLAG is unused\\.$#"
			count: 1
			path: includes/Pricing/MapPricingService.php

		-
			message: "#^Else branch is unreachable because ternary operator condition is always true\\.$#"
			count: 1
			path: includes/Wholesalers/Promotion/VendorProductPromoter.php

		-
			message: "#^Variable \\$regularPrice on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 2
			path: includes/Wholesalers/Promotion/VendorProductPromoter.php

		-
			message: "#^is_wp_error\\(WP_Error\\) will always evaluate to true\\.$#"
			count: 1
			path: includes/Wholesalers/Promotion/VendorProductPromoter.php

		-
			message: "#^Method G2A\\\\POS\\\\Wholesalers\\\\Rsr\\\\RsrFeedImporter\\:\\:classifyByDepartment\\(\\) never returns null so it can be removed from the return type\\.$#"
			count: 1
			path: includes/Wholesalers/Rsr/RsrFeedImporter.php

		-
			message: "#^Method G2A\\\\POS\\\\Wholesalers\\\\SportsSouth\\\\SportsSouthCsvImporter\\:\\:classifyItemType\\(\\) never returns null so it can be removed from the return type\\.$#"
			count: 1
			path: includes/Wholesalers/SportsSouth/SportsSouthCsvImporter.php

		-
			# Intentional: this is a callback on a third-party plugin's action
			# hook (g2ab_booking_created) -- the try/catch is a deliberate
			# "never let a sibling plugin's hook crash on us" guard, not a
			# claim that today's body can throw.
			message: "#^Dead catch \\- Throwable is never thrown in the try block\\.$#"
			count: 1
			path: includes/Integrations/BookingEngineSync.php

		-
			# Intentional: seeding runs from a cron event; the try/catch is a
			# deliberate "a bad knowledge pack or repo write must never kill
			# the cron worker" guard (and schedules the retry), not a claim
			# that today's body can throw.
			message: "#^Dead catch \\- Throwable is never thrown in the try block\\.$#"
			count: 1
			path: includes/Ai/WebsiteKnowledgeSeeder.php

		-
			# Intentional: defensive fallback if wp_timezone()/DateTimeImmutable
			# ever misbehaves with a malformed timezone (a broken locale/i18n
			# plugin can do this) — not a claim that today's stub proves it
			# throws.
			message: "#^Dead catch \\- Throwable is never thrown in the try block\\.$#"
			count: 1
			path: includes/Core/Plugin.php
