{
    "name": "wordpressistic/g2a-business-api",
    "description": "REST API serving the Guns2Ammo Business Control Center dashboard.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "WordPressistic\\G2ABA\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WordPressistic\\G2ABA\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
