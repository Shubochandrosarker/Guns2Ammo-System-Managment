g2a-pos-core/vendor/composer/autoload_files.php

# TypeScript incremental build cache (POS admin)
*.tsbuildinfo

# Root-level plugin/theme zips regenerated by scripts/build-release-zips.sh.
# releases/ (versioned, checked in) is the canonical distributed artifact;
# these root copies are a local convenience and were previously removed as
# stale duplicates (see 635b5fa) — ignore instead of re-tracking them.
/*.zip
!/Images_For_Includeing_on_design.zip

# Booking-engine dev tooling (PHPUnit only; the plugin has no Composer runtime
# dependency). Must NEVER be committed or left on disk when building release
# ZIPs: scripts/build-release-zips.sh deliberately keeps vendor/ (POS needs it),
# and the PDF-invoice module require_once's G2AB_PATH . 'vendor/autoload.php'
# when it exists — so a stray dev vendor/ would ship PHPUnit into production.
# Run `composer install` to test, then remove it.
plugins/g2a-booking-engine/vendor/
plugins/g2a-booking-engine/.phpunit.cache/

# G2A Referrals dev dependencies (unit tests only — the plugin has no
# Composer runtime dependencies, so a vendor/ in the release ZIP would
# ship PHPUnit into production).
plugins/g2a-referrals/vendor/
plugins/g2a-referrals/.phpunit.cache/
