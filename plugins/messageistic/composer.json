{
  "name": "wordpressistic/messageistic",
  "description": "Development tooling for the Messageistic WordPress plugin",
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:unit": "phpunit",
    "lint": "@php tools/php-lint.php",
    "quality": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
