{
    "name": "wordpressistic/g2a-pos-core",
    "description": "Guns2Ammo POS plugin core",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "autoload": {
        "psr-4": {
            "G2A\\POS\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G2A\\POS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage-html --coverage-text",
        "lint": "find includes -name '*.php' -print0 | xargs -0 -n1 php -l 2>&1 | grep -E 'Parse error|Fatal error' && exit 1 || exit 0",
        "analyse": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
