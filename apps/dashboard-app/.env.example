# Base URL of the WordPress site that hosts the g2a-business-api plugin.
# Vite proxies /wp-json/* to this target during dev.
G2A_WP_URL=https://guns2ammo.com

# Full REST base seen by the frontend at runtime, INCLUDING /wp-json/g2a/v1
# (auth contract: endpoints live at {API_BASE}/auth/session/...).
# Leave blank in dev to use the relative '/wp-json/g2a/v1' default, which
# rides through the Vite dev-server proxy above.
VITE_G2A_API_BASE=

# Toggle mock data instead of hitting real WP endpoints. DEV-ONLY:
# production builds always ignore this flag (mock fixtures are tree-shaken
# out of production bundles entirely).
VITE_G2A_USE_MOCKS=1
