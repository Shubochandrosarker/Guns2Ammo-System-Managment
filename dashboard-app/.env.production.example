# Copy to .env.production and fill in the REST base.
# `VITE_G2A_API_BASE` is the ONLY required value in production.
#
# It is the FULL REST base of the g2a-business-api plugin, INCLUDING the
# /wp-json/g2a/v1 suffix (fixed auth contract: {API_BASE}/auth/session/...).
#
# Example: for app.guns2ammo.com pointing at WordPress at guns2ammo.com:
#   VITE_G2A_API_BASE=https://guns2ammo.com/wp-json/g2a/v1
#
# Notes:
#   * Auth is an HttpOnly session cookie + X-G2A-CSRF header; the browser
#     needs credentialed CORS (or a same-origin proxy) between the app
#     origin and this base.
#   * VITE_G2A_USE_MOCKS is IGNORED in production builds — mock mode is
#     dev-only and the fixtures are not present in production bundles.

VITE_G2A_API_BASE=https://guns2ammo.com/wp-json/g2a/v1
