# Copy to .env.production and fill in the WP origin.
# `VITE_G2A_API_BASE` is the ONLY required value in production.
#
# Example: for app.guns2ammo.com pointing at WordPress at guns2ammo.com:
#   VITE_G2A_API_BASE=https://guns2ammo.com
#
# Notes:
#   * Do NOT include /wp-json/g2a/v1 — the client appends it.
#   * If WP lives on a different origin, ensure CORS on WP allows the
#     app subdomain (the g2a-business-api plugin's REST filters do this).
#   * VITE_G2A_USE_MOCKS='1' is a debug escape hatch and must NOT be set
#     in a real production deploy.

VITE_G2A_API_BASE=https://guns2ammo.com
