# Base URL of the WordPress site that hosts the g2a-business-api plugin.
# Vite proxies /wp-json/* to this target during dev.
G2A_WP_URL=https://guns2ammo.com

# Public API base seen by the frontend at runtime. Leave blank to use the
# same origin as the app (recommended when app.guns2ammo.com reverse-proxies
# /wp-json to the WP host).
VITE_G2A_API_BASE=

# Toggle mock data instead of hitting real WP endpoints.
VITE_G2A_USE_MOCKS=1
